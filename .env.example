APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
MEMORY_BACKEND=local
AGENT_WORKSPACE=./workspace
FILE_ACCESS_MODE=local
CONTEXT_CHAR_BUDGET=24000
MAX_TOOL_STEPS=4
LATENCY_TARGET_SECONDS=9.5
RESPONSE_TIMEOUT_SECONDS=120.0
TOOL_TIMEOUT_SECONDS=3.0
HARDWARE_ENABLED=false
HARDWARE_MODE=simulated
CAMERA_BACKEND=none
YOLO_MODEL_PATH=./models/yolo
AUDIO_ENABLED=false
AUDIO_BACKEND=disabled
AUDIO_GATEWAY_URL=http://127.0.0.1:18790
AUDIO_API_KEY=
AUDIO_ASR_MODEL=sensevoice
AUDIO_TTS_MODEL=matcha_zh_en
AUDIO_WORK_DIR=./workspace/audio
AUDIO_MAX_UPLOAD_BYTES=20971520
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3-local:8b
OLLAMA_SUMMARY_MODEL=qwen3-local:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_DISABLE_THINKING=false
OLLAMA_CHAT_MAX_TOKENS=512
OLLAMA_SUMMARY_MAX_TOKENS=350
OLLAMA_KEEP_ALIVE=2m
MEM0_QDRANT_HOST=localhost
MEM0_QDRANT_PORT=6333
MEM0_QDRANT_COLLECTION=self_learning_agent_memories
MEM0_HISTORY_DB_PATH=.data/mem0_history.db
MEM0_TELEMETRY=false
RECENT_MESSAGE_LIMIT=8
MEMORY_RETRIEVAL_LIMIT=5
